# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://gatekeeper:gatekeeper_secret@localhost:5432/gatekeeper_dev"

# Variables para docker-compose (opcionales — tienen defaults en el compose)
POSTGRES_USER=gatekeeper
POSTGRES_PASSWORD=gatekeeper_secret
POSTGRES_DB=gatekeeper_dev
POSTGRES_PORT=5432

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTE_SECRETO_EN_PRODUCCION"
# URL del sitio (sin trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Gatekeeper"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# OPCIONAL pero RECOMENDADO en producción: en Vercel serverless el contador en
# memoria es por-instancia (no global). Con estas dos variables el rate limiting
# pasa a ser global y persistente. Si faltan, cae automáticamente al fallback
# en memoria. Crea una base gratuita en https://console.upstash.com (Redis).
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# ─── Producción (HTTPS obligatorio) ──────────────────────────────────────────
# NEXTAUTH_URL="https://tu-dominio.com"
# NODE_ENV="production"
